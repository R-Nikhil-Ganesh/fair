rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {
// Users can only read/write their own audit documents
match /audits/{uid}/audits/{auditId} {
  allow read, write: if request.auth != null && request.auth.uid == uid;
}

// Users can read their own audit collection metadata
match /audits/{uid} {
  allow read: if request.auth != null && request.auth.uid == uid;
}

// Sample datasets metadata — public read, no write
match /sampleDatasets/{doc} {
  allow read: if true;
  allow write: if false;
}

// All other documents: deny by default
match /{document=**} {
  allow read, write: if false;
}
}
}
